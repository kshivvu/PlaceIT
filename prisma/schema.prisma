generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model College {
  id             String          @id @default(cuid())
  name           String          @unique
  domains        String[]
  createdAt      DateTime        @default(now())
  batches        Batch[]
  studentRecords StudentRecord[]
  users          User[]
}

model Batch {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  collegeId   String
  college     College      @relation(fields: [collegeId], references: [id])
  students    User[]
  assignments Assignment[] @relation("AssignmentBatches")

  @@unique([collegeId, name])
}

model StudentRecord {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  batchName String
  roll      String
  collegeId String
  createdAt DateTime @default(now())
  college   College  @relation(fields: [collegeId], references: [id])

  @@unique([email, collegeId])
}

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  roll               String?
  passwordHash       String?
  avatarUrl          String?
  role               Role               @default(STUDENT)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  emailVerified      DateTime?
  image              String?
  reputationScore    Int                @default(0)
  longestStreak      Int                @default(0)
  currentStreak      Int                @default(0)
  collegeId          String?
  batchId            String?
  leetcodeUsername   String?
  accounts           Account[]
  assignmentsPosted  Assignment[]       @relation("PostedAssignments")
  flags              Flag[]
  notifications      Notification[]
  posts              Post[]
  progressGoal       ProgressGoal?
  progressLog        ProgressLog[]
  sessions           Session[]
  reviewsDone        Submission[]       @relation("SubmissionReviews")
  submissions        Submission[]
  upvotesGiven       Upvote[]
  batch              Batch?             @relation(fields: [batchId], references: [id])
  college            College?           @relation(fields: [collegeId], references: [id])

  @@unique([roll, collegeId])
}

model Assignment {
  id          String         @id @default(cuid())
  type        AssignmentType
  content     Json
  dueDate     DateTime
  createdAt   DateTime       @default(now())
  postedById  String
  postedBy    User           @relation("PostedAssignments", fields: [postedById], references: [id])
  submissions Submission[]
  batches     Batch[]        @relation("AssignmentBatches")
}

model Submission {
  id               String           @id @default(cuid())
  githubLink       String?
  status           SubmissionStatus @default(PENDING)
  isMissed         Boolean          @default(false)
  reviewNote       String?
  submittedAt      DateTime         @default(now())
  updateTime       DateTime         @updatedAt
  reviewedAt       DateTime?
  userId           String
  assignmentId     String
  reviewedById     String?
  colabLink        String?
  leetcodeVerified Boolean?
  flag             Flag?
  assignment       Assignment       @relation(fields: [assignmentId], references: [id])
  reviewedBy       User?            @relation("SubmissionReviews", fields: [reviewedById], references: [id])
  user             User             @relation(fields: [userId], references: [id])

  @@unique([userId, assignmentId])
}

model Flag {
  id           String      @id @default(cuid())
  reason       String
  status       FlagStatus  @default(ACTIVE)
  resolvedNote String?
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?
  userId       String
  submissionId String?     @unique
  submission   Submission? @relation(fields: [submissionId], references: [id])
  user         User        @relation(fields: [userId], references: [id])
}

model ProgressGoal {
  id             String        @id @default(cuid())
  targetCompany  TargetCompany
  timelineMonths Int
  currentLevel   CurrentLevel
  roadMap        Json
  createdAt      DateTime      @default(now())
  upDatedAt      DateTime      @updatedAt
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id])
}

model ProgressLog {
  id             String   @id @default(cuid())
  topics         String[]
  problemsSolved Int
  note           String?
  loggedAt       DateTime @default(now())
  userId         String
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId, loggedAt])
}

model Post {
  id         String   @id @default(cuid())
  content    String
  imageUrl   String?
  isGuidance Boolean  @default(false)
  createdAt  DateTime @default(now())
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  upvotes    Upvote[]
}

model Upvote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

enum Role {
  STUDENT
  FACULTY
  COORDINATOR
  SUPER_ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum AssignmentType {
  DSA
  FULLSTACK
  DEVOPS
  ML
}

enum SubmissionStatus {
  PENDING
  CORRECT
  WRONG
  RESUBMITTED
}

enum FlagStatus {
  ACTIVE
  RESOLVED
  ESCALATED
}

enum TargetCompany {
  PRODUCT_STARTUP
  SERVICE_COMPANY
  FAANG
  OPEN
}

enum CurrentLevel {
  BEGINNER
  SOME_EXPERIENCE
  COMFORTABLE
  STRONG
}

enum NotificationType {
  REMINDER_FIRST
  REMINDER_SECOND
  AUTO_FLAGGED
  ESCALATED
  MONTHLY_DEFAULTER
  STREAK_NUDGE
  POST_UPVOTED
  SUBMISSION_REVIEWED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  VERIFICATION_REQUEST
}
